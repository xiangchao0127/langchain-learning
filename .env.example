# ===========================================================================
# 复制此文件为 .env 后按需修改：  cp .env.example .env
# ===========================================================================

# ------------------------------- LLM 配置 -------------------------------
# 统一使用 OpenAI 兼容协议，因此 DeepSeek / 通义千问 / Kimi / 本地 vLLM 都能直接接入。
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-api-key
# 留空则使用官方地址；接入国内/自建模型时填写兼容端点，例如：
#   DeepSeek : https://api.deepseek.com/v1
#   通义千问 : https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ------------------------------ Doris 配置 ------------------------------
DORIS_HOST=127.0.0.1
# FE 的 MySQL 协议端口，用于建表 / 查询 / 兜底写入
DORIS_MYSQL_PORT=9030
# FE 的 HTTP 端口，用于 Stream Load 高性能导入
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=demo
# 单批写入的行数
DORIS_BATCH_SIZE=500
# Stream Load 超时时间（秒）
DORIS_LOAD_TIMEOUT=300
# 关闭后将强制使用 MySQL INSERT 方式写入
DORIS_STREAM_LOAD_ENABLED=true

# ------------------------------ 运行时配置 ------------------------------
AGENT_OUTPUT_DIR=.output
AGENT_MAX_PREVIEW_CHARS=2000
AGENT_CHUNK_LINES=200
